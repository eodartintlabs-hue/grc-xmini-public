  "module_mappings": [
    {
      "id": "openssl-3-fips",
      "patterns": ["^openssl$", "^libssl.*", "^libcrypto.*", "^pyopenssl$"],
      "ecosystems": ["c_cpp", "python", "pypi", "system", "deb", "rpm", "alpine", "rust", "cargo"],
      "min_version": "3.0.0",
      "cert_numbers": ["4282", "4985", "4857", "4794"],
      "required_mode_signals": ["openssl_fips_enabled", "kernel_fips_enabled", "os_fips_image"],
      "condition_note": "Requires OpenSSL 3 FIPS provider activation ([fips_sect] activate = 1 / default_properties = fips=yes or OSSL_PROVIDER_load('fips'))."
    },
    {
      "id": "openssl-1-historical",
      "patterns": ["^openssl$", "^libssl.*", "^libcrypto.*"],
      "ecosystems": ["c_cpp", "system", "deb", "rpm", "alpine"],
      "max_version_exclusive": "3.0.0",
      "cert_numbers": ["1747"],
      "required_mode_signals": ["openssl_fips_enabled"],
      "condition_note": "OpenSSL 1.x FIPS Object Module 2.0 holds only Historical FIPS 140-2 validation (sunset 2026-09-21) and is End-of-Life."
    },
    {
      "id": "cryptography-pyca",
      "patterns": ["^cryptography$"],
      "ecosystems": ["python", "pypi"],
      "min_version": "41.0.0",
      "cert_numbers": ["4282", "4985", "4857", "4794"],
      "required_mode_signals": ["openssl_fips_enabled", "os_fips_image"],
      "condition_note": "PyCA cryptography must be dynamically linked against the host's validated OpenSSL 3 FIPS provider (not default static PyPI wheels) with FIPS mode enabled."
    },
    {
      "id": "bc-fips-v2",
      "patterns": ["^bc-fips.*", "^bctls-fips.*", "^bcpkix-fips.*"],
      "ecosystems": ["java", "maven", "gradle"],
      "min_version": "2.0.0",
      "cert_numbers": ["4743"],
      "required_mode_signals": ["java_fips_enabled"],
      "condition_note": "BC-FJA 2.x requires JVM provider registration and CryptoServicesRegistrar.setApprovedOnlyMode(true)."
    },
    {
      "id": "bc-fips-v1-historical",
      "patterns": ["^bc-fips.*", "^bctls-fips.*", "^bcpkix-fips.*"],
      "ecosystems": ["java", "maven", "gradle"],
      "min_version": "1.0.0",
      "max_version_exclusive": "2.0.0",
      "cert_numbers": ["3673"],
      "required_mode_signals": ["java_fips_enabled"],
      "condition_note": "BC-FJA 1.0.2.x holds only FIPS 140-2 certificate #3673, which moved to Historical status on 2026-09-21; upgrade to BC-FJA 2.0.x (FIPS 140-3 cert #4743)."
    },
    {
      "id": "aws-lc-fips",
      "patterns": ["^aws-lc-rs$", "^aws-lc-fips-sys$", "^aws-lc$"],
      "ecosystems": ["rust", "cargo", "c_cpp", "system"],
      "min_version": "1.0.0",
      "cert_numbers": ["4759"],
      "required_mode_signals": ["rust_fips_feature", "os_fips_image"],
      "condition_note": "aws-lc-rs / rustls requires Cargo feature 'fips' (or 'aws-lc-fips-sys') to link the CMVP-validated AWS-LC FIPS module."
    },
    {
      "id": "boringcrypto",
      "patterns": ["^boring$", "^boring-sys$", "^boringssl$"],
      "ecosystems": ["rust", "cargo", "c_cpp", "go", "golang"],
      "cert_numbers": ["4735"],
      "required_mode_signals": ["go_boringcrypto_enabled", "rust_fips_feature"],
      "condition_note": "Requires BoringCrypto FIPS build flag (GOEXPERIMENT=boringcrypto or crate 'fips' feature)."
    },
    {
      "id": "wolfcrypt-fips",
      "patterns": ["^wolfssl.*", "^wolfcrypt.*"],
      "ecosystems": ["c_cpp", "system", "python", "pypi", "rust", "cargo"],
      "min_version": "5.5.0",
      "cert_numbers": ["4718"],
      "required_mode_signals": ["wolfcrypt_fips_enabled"],
      "condition_note": "Requires commercial wolfCrypt FIPS 140-3 build (--enable-fips=v5)."
    }
  ],
